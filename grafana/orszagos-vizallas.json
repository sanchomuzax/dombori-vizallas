    {
      "id": 5,
      "type": "timeseries",
      "title": "Duna vízállás a négy ponton — mért + Hydroinfo előrejelzés",
      "description": "Folytonos = mért (28 napnál régebbre archív napi átlag), szaggatott = a legutóbbi Hydroinfo-előrejelzés. Színek: kék = Komárom, lila = Budapest, narancs = Paks, zöld = Mohács.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DOMBORI}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "rawSql": "SELECT o.ts_utc AS \"time\", CASE o.station_tsz WHEN 5 THEN 'Komárom' WHEN 1026 THEN 'Budapest' WHEN 549 THEN 'Paks' ELSE 'Mohács' END AS metric, o.value_cm FROM observations o WHERE o.station_tsz IN (5, 1026, 549, 831) AND $__timeFilter(o.ts_utc) UNION ALL SELECT (d.day_local::timestamp + interval '12 hours') AT TIME ZONE 'Europe/Budapest' AS \"time\", CASE d.station_tsz WHEN 5 THEN 'Komárom' WHEN 1026 THEN 'Budapest' WHEN 549 THEN 'Paks' ELSE 'Mohács' END AS metric, d.mean_cm FROM daily_aggregates d WHERE d.station_tsz IN (5, 1026, 549, 831) AND $__timeFilter(d.day_local) AND d.day_local < (now() AT TIME ZONE 'Europe/Budapest')::date - 27 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "rawSql": "SELECT target_ts AS \"time\", value_cm AS \"Komárom előrejelzés\" FROM forecast_points WHERE point_type = 'forecast' AND run_id = (SELECT id FROM forecast_runs WHERE station_code = '442522H' ORDER BY issue_ts DESC LIMIT 1) ORDER BY 1"
        },
        {
          "refId": "C",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "rawSql": "SELECT target_ts AS \"time\", value_cm AS \"Budapest előrejelzés\" FROM forecast_points WHERE point_type = 'forecast' AND run_id = (SELECT id FROM forecast_runs WHERE station_code = '442027H' ORDER BY issue_ts DESC LIMIT 1) ORDER BY 1"
        },
        {
          "refId": "D",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "rawSql": "SELECT target_ts AS \"time\", value_cm AS \"Paks előrejelzés\" FROM forecast_points WHERE point_type = 'forecast' AND run_id = (SELECT id FROM forecast_runs WHERE station_code = '442030H' ORDER BY issue_ts DESC LIMIT 1) ORDER BY 1"
        },
        {
          "refId": "E",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "rawSql": "SELECT target_ts AS \"time\", value_cm AS \"Mohács előrejelzés\" FROM forecast_points WHERE point_type = 'forecast' AND run_id = (SELECT id FROM forecast_runs WHERE station_code = '442032H' ORDER BY issue_ts DESC LIMIT 1) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "enableFacetedFilter": false,
          "overflow": "ellipsis",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthcm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "showPoints": "auto",
            "pointSize": 5,
            "thresholdsStyle": {
