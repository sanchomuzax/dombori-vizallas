    {
      "id": 6,
      "type": "timeseries",
      "title": "Komárom: mért + előrejelzés (±sáv)",
      "description": "Zöld terület LKV (-12 cm) fölött, piros LNV (845 cm) fölött.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DOMBORI}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "rawSql": "SELECT ts_utc AS \"time\", value_cm AS \"mért\" FROM observations WHERE station_tsz = 5 AND $__timeFilter(ts_utc) UNION ALL SELECT (day_local::timestamp + interval '12 hours') AT TIME ZONE 'Europe/Budapest' AS \"time\", mean_cm FROM daily_aggregates WHERE station_tsz = 5 AND $__timeFilter(day_local) AND day_local < (now() AT TIME ZONE 'Europe/Budapest')::date - 27 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "rawSql": "WITH last_obs AS (SELECT ts_utc, value_cm FROM observations WHERE station_tsz = 5 ORDER BY ts_utc DESC LIMIT 1) SELECT ts_utc AS \"time\", value_cm AS \"előrejelzés\" FROM last_obs UNION ALL SELECT target_ts, value_cm FROM forecast_points WHERE point_type = 'forecast' AND target_ts > (SELECT ts_utc FROM last_obs) AND run_id = (SELECT id FROM forecast_runs WHERE station_code = '442522H' ORDER BY issue_ts DESC LIMIT 1) ORDER BY 1"
        },
        {
          "refId": "C",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "rawSql": "WITH last_obs AS (SELECT ts_utc, value_cm FROM observations WHERE station_tsz = 5 ORDER BY ts_utc DESC LIMIT 1) SELECT ts_utc AS \"time\", value_cm AS \"felső\", value_cm AS \"alsó\" FROM last_obs UNION ALL SELECT target_ts, value_cm + coalesce(error_band_cm, 0), value_cm - coalesce(error_band_cm, 0) FROM forecast_points WHERE point_type = 'forecast' AND target_ts > (SELECT ts_utc FROM last_obs) AND run_id = (SELECT id FROM forecast_runs WHERE station_code = '442522H' ORDER BY issue_ts DESC LIMIT 1) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "enableFacetedFilter": false,
          "overflow": "ellipsis",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthcm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "showPoints": "auto",
            "pointSize": 5,
            "thresholdsStyle": {
              "mode": "area"
            },
            "axisSoftMin": -60,
            "axisSoftMax": 900
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "green",
                "value": -12
              },
              {
                "color": "red",
                "value": 845
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mért"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "előrejelzés"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "color",
