          "rawSql": "SELECT DISTINCT ON (job) CASE job WHEN 'collect' THEN 'Vízállás-gyűjtés (15 percenként)' WHEN 'hydroinfo' THEN 'Duna-előrejelzés letöltése (óránként)' WHEN 'daily' THEN 'Hajnali karbantartás (03:30)' WHEN 'bartal-forecast' THEN 'Bartal-előrejelzés számítása' WHEN 'backfill' THEN 'Történelmi betöltés (egyszeri, kész)' ELSE job END AS \"Feladat\", to_char(started_at AT TIME ZONE 'Europe/Budapest', 'MM.DD. HH24:MI') AS \"Utolsó futás\", CASE status WHEN 'ok' THEN 'Rendben' WHEN 'noop' THEN 'Nem volt új adat' WHEN 'error' THEN 'HIBA' WHEN 'running' THEN 'Éppen fut' ELSE status END AS \"Eredmény\", rows_upserted AS \"Új adatsor\" FROM ingestion_runs ORDER BY job, started_at DESC",
          "refId": "A"
        }
