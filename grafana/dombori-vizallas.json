          "format": "time_series",
          "rawSql": "SELECT ts_utc AS \"time\", value_cm AS \"mért\" FROM observations WHERE station_tsz = 550 AND $__timeFilter(ts_utc) UNION ALL SELECT (day_local::timestamp + interval '12 hours') AT TIME ZONE 'Europe/Budapest' AS \"time\", mean_cm FROM daily_aggregates WHERE station_tsz = 550 AND $__timeFilter(day_local) AND day_local < (now() AT TIME ZONE 'Europe/Budapest')::date - 27 ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "format": "time_series",
          "rawSql": "SELECT target_ts AS \"time\", value_cm AS \"előrejelzés\" FROM forecast_points WHERE point_type = 'forecast' AND run_id = (SELECT id FROM forecast_runs WHERE station_code = '442540H' ORDER BY issue_ts DESC LIMIT 1) ORDER BY 1",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DOMBORI}"
          },
          "format": "time_series",
          "rawSql": "SELECT target_ts AS \"time\", value_cm + coalesce(error_band_cm, 0) AS \"felső\", value_cm - coalesce(error_band_cm, 0) AS \"alsó\" FROM forecast_points WHERE point_type = 'forecast' AND run_id = (SELECT id FROM forecast_runs WHERE station_code = '442540H' ORDER BY issue_ts DESC LIMIT 1) ORDER BY 1",
          "refId": "C"
        }
      ],
      "title": "Duna-Dombori: mért + Hydroinfo előrejelzés (±sáv)",
      "type": "timeseries"
